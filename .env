CDP_URL=http://localhost:9222

# MongoDB Atlas connection string (leave empty to track processed posts in memory only)
MONGODB_URI=
MONGODB_DB=xengageai

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Your own @handle (without the @) so the bot never replies to your own posts
X_HANDLE=adhirajranjann

# Behaviour (use the --dry-run command line flag to test without posting)
REQUIRE_APPROVAL=false
LIKE_ON_REPLY=true
LIKE_ON_SKIP=false

# Limits and pacing
MAX_REPLY_CHARS=280
MAX_REPLIES_PER_RUN=80
MAX_REPLIES_PER_DAY=160
DELAY_MIN=8
DELAY_MAX=20
GPT_TIMEOUT=60
REFRESH_EVERY=25 # after every x posts
