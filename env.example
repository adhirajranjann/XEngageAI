CDP_URL=http://localhost:9222

# MongoDB Atlas connection string (leave empty to track processed posts in memory only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=xengageai

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Your own @handle (without the @) so the bot never replies to your own posts
X_HANDLE=yourhandle

# Behaviour (use the --dry-run command line flag to test without posting)
REQUIRE_APPROVAL=false
LIKE_ON_REPLY=true
LIKE_ON_SKIP=false

# Limits and pacing
MAX_REPLY_CHARS=280
MAX_REPLIES_PER_RUN=25
MAX_REPLIES_PER_DAY=50

# Only process posts with MORE views than this (0 = no filter)
MIN_VIEWS=50000

# Only process posts published less than this many minutes ago (0 = no filter)
MAX_POST_AGE_MINUTES=60

# Reload the timeline after this many posts (0 = never)
REFRESH_EVERY=25

# Seconds to wait for ChatGPT to answer
GPT_TIMEOUT=180
